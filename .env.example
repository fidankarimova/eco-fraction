# Copy to .env to override any default. Nothing here is required to run.

# --- storage ---------------------------------------------------------------
# SQLite by default: a single local file, no server, no credentials.
# To use a local PostgreSQL instead:
#   ECO_DATABASE_URL=postgresql+psycopg://ecofraction:ecofraction@localhost:5432/ecofraction
ECO_DATABASE_URL=sqlite:///./data/ecofraction.db
ECO_SQL_ECHO=false

# --- simulated device fleet ------------------------------------------------
ECO_ENABLE_SIMULATOR=true
ECO_SAMPLE_INTERVAL_SECONDS=5

# --- history backfill on an empty database --------------------------------
ECO_AUTO_BACKFILL=true
ECO_BACKFILL_DAYS=7
ECO_BACKFILL_STEP_MINUTES=5

# --- misc ------------------------------------------------------------------
ECO_LOG_LEVEL=INFO
ECO_ENVIRONMENT=local
ECO_SERVE_FRONTEND=true
